---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'すい — 学生・地元のLLM研究中',
  description = '手元でローカルLLMを動かす学生「すい」の個人ページ。研究・作品・メモを記録しています。',
} = Astro.props;

const site = Astro.site ?? new URL('https://cwd514.github.io/');
const canonical = new URL(Astro.url.pathname, site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="すい" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@sui_egamer" />
  </head>
  <body>
    <a class="skip" href="#main">本文へスキップ</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="dot" aria-hidden="true"></span>すい</a>
        <nav class="site-nav" aria-label="ナビゲーション">
          <a href="/#about">About</a>
          <a href="/#works">Works</a>
          <a href="/#next">Next</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {year} すい</span>
        <span class="footer-links">
          <a href="https://github.com/cwd514" target="_blank" rel="me noopener noreferrer">GitHub</a>
          <span aria-hidden="true">·</span>
          <a href="https://x.com/sui_egamer" target="_blank" rel="me noopener noreferrer">X</a>
        </span>
      </div>
    </footer>
  </body>
</html>
